# Your app's credentials from the Dev Dashboard
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# The shop the sample runs against, e.g. my-dev-store (without .myshopify.com)
SHOPIFY_SHOP=

# Shared secret that authorizes background calls to POST /refresh.
# Generate a long random value, e.g.: openssl rand -hex 32
REFRESH_TASK_SECRET=
